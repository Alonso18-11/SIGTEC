<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- HU-09 (RF-941, D-9): las fotos de evidencia no salen del celular, ni a la copia en la nube ni al
         pasar los datos a otro celular (Android 12 o superior). Lo demás sigue como antes. -->
    <cloud-backup>
        <exclude domain="file" path="evidencias/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="evidencias/" />
    </device-transfer>
</data-extraction-rules>