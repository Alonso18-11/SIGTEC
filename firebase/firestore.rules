rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones de apoyo ----------
    function autenticado() { return request.auth != null; }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil;
    }

    function esJefe()    { return autenticado() && perfil() == 'JEFE'; }
    function esTecnico() { return autenticado() && perfil() == 'TECNICO'; }

    // El cambio solo toca los campos indicados
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // Técnico asignado antes y después de un cambio de incidencia (null si no tiene)
    function tecnicoAntes()   { return resource.data.get('tecnicoAsignadoId', null); }
    function tecnicoDespues() { return request.resource.data.get('tecnicoAsignadoId', null); }
    function cambiaTecnico()  { return tecnicoDespues() != tecnicoAntes(); }

    // Marca de la incidencia antes y después de un cambio, y si ese cambio la cierra (RF-823, HU-08)
    function marcaAntes()    { return resource.data.marca; }
    function marcaDespues()  { return request.resource.data.marca; }
    function seCierra() { return marcaAntes() != 'CERRADA' && marcaDespues() == 'CERRADA'; }

    // Carga de un técnico antes y después de la escritura (getAfter ve la transacción completa)
    function cargaDe(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.incidenciasActivas;
    }
    function cargaDespuesDe(uid) {
      return getAfter(/databases/$(database)/documents/usuarios/$(uid)).data.incidenciasActivas;
    }

    // RF-622: al cambiar de técnico, el nuevo suma 1 y el anterior resta 1 en la misma escritura
    function cargaMovida() {
      return (tecnicoDespues() == null || cargaDespuesDe(tecnicoDespues()) == cargaDe(tecnicoDespues()) + 1)
        && (tecnicoAntes() == null || cargaDespuesDe(tecnicoAntes()) == cargaDe(tecnicoAntes()) - 1);
    }

    // RF-823 (HU-08): el técnico que cierra resta 1 a su propia carga en la misma escritura
    function cargaRestadaAlCerrar() {
      return cargaDespuesDe(request.auth.uid) == cargaDe(request.auth.uid) - 1;
    }

    // ---------- Usuarios ----------
    match /usuarios/{uid} {
      allow read: if autenticado();
      // Se crean desde la consola. La app solo mueve la carga del técnico,
      // y nunca por encima de su límite: RF-06 también en el servidor.
      allow update: if (esJefe() || request.auth.uid == uid)
        && soloCambia(['incidenciasActivas'])
        && request.resource.data.incidenciasActivas >= 0
        && request.resource.data.incidenciasActivas <= resource.data.limiteAtencion;
      allow create, delete: if false;
    }

    // ---------- Incidencias ----------
    match /incidencias/{id} {
      allow read: if autenticado();
      // Nace sin asignar y a nombre de quien la registra
      allow create: if autenticado()
        && request.resource.data.registradoPorId == request.auth.uid
        && request.resource.data.marca == 'SIN_ASIGNAR';
      // La modifica el jefe (asignar, clasificar) o el técnico asignado (atender, cerrar).
      // Cambiar de técnico mueve la carga de los dos en la misma escritura: con la regla de
      // /usuarios (carga entre 0 y el límite) es RF-06 en el servidor (RF-622). Una cerrada no se reasigna.
      // El técnico asignado no puede cambiar quién es el técnico asignado (RF-623).
      // Al cerrar, el técnico asignado debe restar 1 a su propia carga en la misma escritura (RF-823, HU-08).
      allow update: if (esJefe() && (!cambiaTecnico() || (resource.data.marca != 'CERRADA' && cargaMovida())))
        || (esTecnico() && tecnicoAntes() == request.auth.uid && !cambiaTecnico()
            && (!seCierra() || cargaRestadaAlCerrar()));
      allow delete: if false;
    }

    // ---------- Línea de tiempo: no se reescribe ----------
    match /movimientos/{id} {
      allow read, create: if autenticado();
      allow update, delete: if false;
    }

    // ---------- Informe: solo el técnico asignado, con huella ----------
    match /informes/{incidenciaId} {
      allow read: if autenticado();
      // RF-823 (HU-08): el diagnóstico es obligatorio, igual que confirmadoEn (RNF de trazabilidad).
      allow create: if esTecnico()
        && get(/databases/$(database)/documents/incidencias/$(incidenciaId))
             .data.tecnicoAsignadoId == request.auth.uid
        && request.resource.data.confirmadoEn is timestamp
        && request.resource.data.diagnostico is string && request.resource.data.diagnostico.size() > 0;
      allow update, delete: if false;
    }

    // ---------- Repuestos ----------
    match /solicitudesRepuesto/{id} {
      allow read: if autenticado();
      // RF-1118 (HU-11, D-8): solo el técnico asignado a la incidencia, a su nombre y con la confirmación biométrica
      allow create: if esTecnico()
        && request.resource.data.solicitadoPorId == request.auth.uid
        && get(/databases/$(database)/documents/incidencias/$(request.resource.data.incidenciaId))
             .data.tecnicoAsignadoId == request.auth.uid
        && request.resource.data.confirmadoEn is timestamp;
      // Solo cambia lo que informa Logística: número, estado de entrega, sus fechas y el rechazo
      allow update: if esTecnico() && soloCambia([
        'numeroLogistica', 'estadoEntrega', 'despachadaEn', 'entregadaEn', 'llegadaEstimada',
        'rechazadaPorLogistica', 'actualizadoEn'
      ]);
      allow delete: if false;
    }

    // ---------- IA ----------
    match /sugerenciasIA/{id} {
      allow read, create: if autenticado();
      allow update: if autenticado() && soloCambia(['aceptada']);
      allow delete: if false;
    }

    // ---------- Diccionario ----------
    // HU-13 (RF-1323): solo un técnico, a su nombre, con los campos de RF-1320 y sin campos extra
    function textoLleno(campo) {
      return request.resource.data[campo] is string && request.resource.data[campo].trim().size() > 0;
    }
    function fallaValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['titulo', 'sintomas', 'componente', 'tipo', 'solucion', 'autorId',
                               'autorNombre', 'incidenciaOrigenId', 'registradaEn'])
        && d.keys().hasAll(['titulo', 'sintomas', 'componente', 'tipo', 'solucion', 'autorId',
                            'autorNombre', 'registradaEn'])
        && textoLleno('titulo') && textoLleno('sintomas') && textoLleno('componente')
        && textoLleno('solucion') && textoLleno('autorNombre')
        && d.tipo in ['HARDWARE', 'SOFTWARE', 'RED']
        && d.autorId == request.auth.uid
        && (d.get('incidenciaOrigenId', null) == null || d.incidenciaOrigenId is string)
        && d.registradaEn is timestamp;
    }

    match /fallas/{id} {
      allow read: if autenticado();
      allow create: if esTecnico() && fallaValida();
      // D-4: no se editan. Solo se acepta volver a subir exactamente lo mismo (un reintento de la subida)
      allow update: if esTecnico() && request.resource.data == resource.data;
      allow delete: if false;
    }

    // ---------- Catálogo ----------
    match /equipos/{codigo} {
      allow read: if autenticado();
      allow write: if false;
    }

    // ---------- Numeración INC: solo de uno en uno ----------
    match /contadores/incidencias {
      allow read: if autenticado();
      // La primera incidencia de todo el proyecto crea el contador; después solo se incrementa de 1 en 1 (RF-69)
      allow create: if autenticado() && request.resource.data.ultimo == 1;
      allow update: if autenticado()
        && request.resource.data.ultimo == resource.data.ultimo + 1;
    }
  }
}